# QueueLess Environment Variables Configuration
# Copy this file to .env and provide your production or local values.

# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console > APIs & Services > Credentials
# Configure Authorized JavaScript origins (e.g. http://localhost:3000 or your domain)
# Configure Authorized redirect URIs (e.g. http://localhost:3000/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# Application Session Secret (Random string for secure session signing)
SECRET_KEY="queueless_super_secure_production_secret_key_change_in_prod"

# Database Configuration (Relational Database)
# Development: SQLite (queueless.db created automatically)
# Production: PostgreSQL (e.g. postgresql://user:password@hostname:5432/queueless)
DATABASE_URL="sqlite:///./queueless.db"

# Server Port
PORT=3000

# Gemini AI API Key (Injected by AI Studio if available)
GEMINI_API_KEY=""

# Application Host URL (Injected by AI Studio runtime)
APP_URL=""
